            </VerticalLayout>
          </HorizontalLayout>
        </VerticalLayout>
        
        <!-- 诊断与自检页 -->
        <VerticalLayout name="Page3" inset="12,12,12,12">
          <HorizontalLayout>
            <VerticalLayout width="500" bkcolor="#FF161B25" bordercolor="#FF222A37" bordersize="1" roundcorner="13,13" inset="12,12">
              <HorizontalLayout height="28">
                <VerticalLayout width="28" height="28" bkcolor="#FF11291C" roundcorner="8,8">
                  <Text text="✓" font="2" textcolor="#FF46D07F" align="center" />
                </VerticalLayout>
                <Text text="运行时依赖" font="3" textcolor="#FFE9EEF8" inset="12,0,0,0" />
                <Button text="重新检查" width="80" height="28" bkcolor="transparent" textcolor="#FF9BA7BD" roundcorner="6,6" name="BtnRecheck" />
              </HorizontalLayout>
              
              <Text text="按当前运行目录实时检查" font="1" textcolor="#FF6B7689" />
              <Text text="尚未检查" font="2" textcolor="#FF9BA7BD" name="DiagnosticsSummary" />
              
              <VerticalLayout name="DiagnosticsList"></VerticalLayout>
            </VerticalLayout>
            
            <VerticalLayout inset="15,0,0,0">
              <VerticalLayout bkcolor="#FF161B25" bordercolor="#FF222A37" bordersize="1" roundcorner="13,13" inset="12,12" height="200">
                <HorizontalLayout height="28">
                  <VerticalLayout width="28" height="28" bkcolor="#FF2E2411" roundcorner="8,8">
                    <Text text="📋" font="2" textcolor="#FFF2B45C" align="center" />
                  </VerticalLayout>
                  <Text text="日志与会话" font="3" textcolor="#FFE9EEF8" inset="12,0,0,0" />
                </HorizontalLayout>
                <Text text="日志同时写入磁盘，清空界面不影响文件" font="1" textcolor="#FF6B7689" />
                
                <Button text="打开日志目录" height="30" bkcolor="#FF10151E" bordercolor="#FF2E3849" bordersize="1" textcolor="#FFE9EEF8" roundcorner="8,8" name="BtnOpenLog" />
                
                <HorizontalLayout height="24">
                  <Text text="界面日志条数：" width="100" textcolor="#FF9BA7BD" />
                  <Text text="0 条" textcolor="#FFE9EEF8" name="LogCount" />
                </HorizontalLayout>
              </VerticalLayout>
              
              <VerticalLayout bkcolor="#FF161B25" bordercolor="#FF222A37" bordersize="1" roundcorner="13,13" inset="12,12" inset="0,15,0,0">
                <HorizontalLayout height="28">
                  <VerticalLayout width="28" height="28" bkcolor="#FF122536" roundcorner="8,8">
                    <Text text="🔣" font="2" textcolor="#FF63B8FF" align="center" />
                  </VerticalLayout>
                  <Text text="界面冒烟自检" font="3" textcolor="#FFE9EEF8" inset="12,0,0,0" />
                </HorizontalLayout>
                <Text text="覆盖导航、日志筛选、面板拖拽与依赖检查" font="1" textcolor="#FF6B7689" />
                
                <Button text="运行界面自检" height="30" bkcolor="#FF10151E" bordercolor="#FF2E3849" bordersize="1" textcolor="#FFE9EEF8" roundcorner="8,8" name="BtnSmokeTest" />
                <Text text="在界面内执行一组只读检查，结果写入日志面板。" font="1" textcolor="#FF9BA7BD" />
                <Text text="尚未运行自检。" font="1" textcolor="#FF6B7689" name="SmokeResult" />
              </VerticalLayout>
            </VerticalLayout>
          </HorizontalLayout>
        </VerticalLayout>
      </TabLayout>
    </HorizontalLayout>
    
    <HorizontalLayout height="5" bkcolor="#FF10141C" bordercolor="#FF222A37" bordersize="0,1,0,1" name="DragHandle" mouse="true">
      <VerticalLayout width="46" height="4" bkcolor="#FF2E3849" roundcorner="2,2" align="center" />
    </HorizontalLayout>
    
    <VerticalLayout height="190" name="LogPanel" bkcolor="#FF0C0F16">
      <HorizontalLayout height="34" bkcolor="#FF11151D" bordercolor="#FF222A37" bordersize="0,0,0,1">
        <Button text=" 折叠" width="70" textcolor="#FF9BA7BD" name="BtnFold" />
        <Combo name="LogFilter" width="80" textcolor="#FF9BA7BD">
          <ListLabel text="全部" />
          <ListLabel text="信息" />
          <ListLabel text="调试" />
          <ListLabel text="错误" />
        </Combo>
        <Button text="跟随" width="50" textcolor="#FF9BA7BD" name="BtnFollow" />
        <Button text="复制" width="50" textcolor="#FF9BA7BD" name="BtnCopy" />
        <Button text="清空" width="50" textcolor="#FF9BA7BD" name="BtnClear" />
        <Text text="0 条" textcolor="#FF6B7689" name="LogCountText" />
      </HorizontalLayout>
      
      <List name="LogList" vscrollbar="true" hscrollbar="false" bkcolor="#FF0C0F16">
        <ListHeader height="0" />
      </List>
    </VerticalLayout>
  </VerticalLayout>
</Window>
